@using Elsa.Studio.Contracts
@using Elsa.Studio.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IMenuService MenuService;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<NavMenu> Logger

<MudNavMenu Color="Color.Primary" Margin="Margin.Dense" Class="studio-nav">
    @foreach (var menuItemGroup in _menuItemsGroups.Values)
    {
        var menuItems = _menuItems.Where(x => x.GroupName == menuItemGroup.Name).ToList();

        @if (menuItems.Any())
        {
            <MudText Typo="Typo.overline" Class="studio-nav__group-label">@menuItemGroup.Text</MudText>

            foreach (var menuItem in menuItems)
            {
                <NavMenuItem MenuItem="menuItem" />
            }
        }
    }
</MudNavMenu>

@code
{
    private IDictionary<string, MenuItemGroup> _menuItemsGroups = new Dictionary<string, MenuItemGroup>();
    private IEnumerable<MenuItem> _menuItems = new List<MenuItem>();
    private readonly CancellationTokenSource _lifetime = new();
    private readonly object _refreshSync = new();
    private CancellationTokenSource? _refreshCancellation;
    private long _authenticationGeneration;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        var generation = Volatile.Read(ref _authenticationGeneration);
        var menu = await LoadMenuAsync(_lifetime.Token);

        if (IsCurrentGeneration(generation))
            PublishMenu(menu);
    }

    private async Task<(IDictionary<string, MenuItemGroup> Groups, IEnumerable<MenuItem> Items)> LoadMenuAsync(CancellationToken cancellationToken)
    {
        var groups = (await MenuService.GetMenuItemGroupsAsync(cancellationToken)).ToDictionary(x => x.Name);
        var items = await MenuService.GetMenuItemsAsync(cancellationToken);
        return (groups, items);
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        CancellationTokenSource refreshCancellation;
        long generation;

        lock (_refreshSync)
        {
            generation = ++_authenticationGeneration;
            _refreshCancellation?.Cancel();
            _refreshCancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
            refreshCancellation = _refreshCancellation;
        }

        _ = RefreshMenuAsync(authenticationStateTask, generation, refreshCancellation);
    }

    private async Task RefreshMenuAsync(
        Task<AuthenticationState> authenticationStateTask,
        long generation,
        CancellationTokenSource refreshCancellation)
    {
        try
        {
            await authenticationStateTask.WaitAsync(refreshCancellation.Token);
            await InvokeAsync(async () =>
            {
                if (!IsCurrentGeneration(generation))
                    return;

                _menuItems = [];
                StateHasChanged();
                var menu = await LoadMenuAsync(refreshCancellation.Token);

                if (IsCurrentGeneration(generation))
                {
                    PublishMenu(menu);
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested)
        {
            Logger.LogDebug("Skipping a stale navigation menu refresh");
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Reloading the navigation menu after an authentication change failed");
        }
        finally
        {
            lock (_refreshSync)
            {
                if (ReferenceEquals(_refreshCancellation, refreshCancellation))
                    _refreshCancellation = null;
            }

            refreshCancellation.Dispose();
        }
    }

    private bool IsCurrentGeneration(long generation) =>
        Volatile.Read(ref _authenticationGeneration) == generation && !_lifetime.IsCancellationRequested;

    private void PublishMenu((IDictionary<string, MenuItemGroup> Groups, IEnumerable<MenuItem> Items) menu)
    {
        _menuItemsGroups = menu.Groups;
        _menuItems = menu.Items;
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        _lifetime.Cancel();
        lock (_refreshSync)
        {
            _refreshCancellation?.Cancel();
        }
        _lifetime.Dispose();
    }
}
