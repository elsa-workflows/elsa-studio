@using Elsa.Studio.Contracts
@using Elsa.Studio.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject IMenuService MenuService;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<NavMenu> Logger

<MudNavMenu Color="Color.Primary" Margin="Margin.Dense" Class="studio-nav">
    @foreach (var menuItemGroup in _menuItemsGroups.Values)
    {
        var menuItems = _menuItems.Where(x => x.GroupName == menuItemGroup.Name).ToList();

        @if (menuItems.Any())
        {
            <MudText Typo="Typo.overline" Class="studio-nav__group-label">@menuItemGroup.Text</MudText>

            foreach (var menuItem in menuItems)
            {
                <NavMenuItem MenuItem="menuItem" />
            }
        }
    }
</MudNavMenu>

@code
{
    private IDictionary<string, MenuItemGroup> _menuItemsGroups = new Dictionary<string, MenuItemGroup>();
    private IEnumerable<MenuItem> _menuItems = new List<MenuItem>();
    private readonly CancellationTokenSource _lifetime = new();

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await LoadMenuAsync(_lifetime.Token);
    }

    private async Task LoadMenuAsync(CancellationToken cancellationToken)
    {
        _menuItemsGroups = (await MenuService.GetMenuItemGroupsAsync(cancellationToken)).ToDictionary(x => x.Name);
        _menuItems = await MenuService.GetMenuItemsAsync(cancellationToken);
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask) =>
        _ = RefreshMenuAsync(authenticationStateTask);

    private async Task RefreshMenuAsync(Task<AuthenticationState> authenticationStateTask)
    {
        try
        {
            await authenticationStateTask;
            await InvokeAsync(async () =>
            {
                _menuItems = [];
                StateHasChanged();
                await LoadMenuAsync(_lifetime.Token);
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Reloading the navigation menu after an authentication change failed");
        }
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
