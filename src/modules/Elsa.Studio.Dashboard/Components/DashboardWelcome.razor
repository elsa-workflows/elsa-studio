@using Elsa.Studio.Contracts
@using Elsa.Studio.Extensions
@using Elsa.Studio.Models
@inject IMenuService MenuService
@inject ILocalizer Localizer

@* Shown instead of the dashboard to a user who may see none of its widgets. *@
@if (_pages == null)
{
    @* Loading the navigation. *@
}
else if (_pages.Count == 0)
{
    <NoAccessiblePages />
}
else
{
    <MudPaper Outlined="true" Elevation="0" Class="dashboard-panel" Style="@DashboardStyles.Panel" data-testid="dashboard-welcome">
        <MudText Typo="Typo.h6">@Localizer["Welcome"]</MudText>
        <MudText Typo="Typo.body2" Class="mb-3" Style="color:var(--mud-palette-text-secondary);">
            @Localizer["Nothing on the dashboard is available to your role. These are the pages you can open:"]
        </MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
            @foreach (var shortcut in _pages)
            {
                <MudButton Href="@shortcut.Href.TrimStart('/')" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@shortcut.Icon">@shortcut.Text</MudButton>
            }
        </MudStack>
    </MudPaper>
}

@code {
    private IReadOnlyList<MenuItem>? _pages;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync() => _pages = (await MenuService.GetNavigationAsync()).GetPages().ToList();
}
