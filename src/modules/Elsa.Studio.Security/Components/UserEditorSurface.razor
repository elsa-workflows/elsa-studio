@inherits StudioComponentBase
@implements IAsyncDisposable

<style>
    .user-editor-surface {
        --user-editor-primary-aa: color-mix(in srgb, var(--mud-palette-primary), var(--mud-palette-text-primary) 32%);
        min-block-size: calc(100dvh - var(--mud-appbar-height) - 2rem);
    }

    .user-editor-summary { padding: 1rem; }
    .user-editor-header { align-items: center; display: flex; gap: 1rem; }
    .user-editor-identity { align-items: center; display: flex; gap: 1rem; min-width: 0; }
    .user-editor-title-group { min-width: 0; }
    .user-editor-title { color: var(--user-editor-primary-aa); }
    .user-editor-meta { align-items: center; color: var(--mud-palette-text-secondary); display: flex; flex-wrap: wrap; gap: .25rem .75rem; }
    .user-editor-id { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; overflow-wrap: anywhere; }
    .user-editor-actions { align-items: center; background: var(--mud-palette-surface); border-top: 1px solid var(--mud-palette-lines-default); bottom: 0; display: flex; gap: .5rem; margin-top: auto; padding: .75rem 1rem max(.75rem, env(safe-area-inset-bottom)); position: sticky; z-index: 2; }
    .user-editor-commit-actions { align-items: center; display: flex; gap: .5rem; margin-left: auto; }
    .user-editor-primary-action.mud-button-text { color: var(--user-editor-primary-aa); }
    .user-section-header { margin-bottom: 1rem; }
    .user-section-title { margin-bottom: .25rem; }
    .user-section-hint { color: var(--mud-palette-text-secondary); }

    @@media (max-width: 599.98px) {
        .user-editor-actions { align-items: stretch; flex-wrap: wrap; }
        .user-editor-delete-action { flex: 1 0 100%; }
        .user-editor-commit-actions { margin-left: 0; width: 100%; }
        .user-editor-commit-actions .mud-button-root { flex: 1 1 50%; }
    }
</style>

@if (_loading)
{
    <MudStack AlignItems="AlignItems.Center" Class="pa-8" Role="status">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="Loading user" />
        <MudText Typo="Typo.body2">Loading user…</MudText>
    </MudStack>
}
else if (_loadError != null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        <MudText Typo="Typo.subtitle1">Could not load user</MudText>
        <MudText Typo="Typo.body2">@_loadError</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-3" Href="security/users">Back to users</MudButton>
    </MudAlert>
}
else if (!CanOpen)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        You can view users, but your current sign-in cannot create a user. Ask an administrator for <code>identity/users:create</code>.
    </MudAlert>
}
else
{
    <MudStack Spacing="3" Class="user-editor-surface">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Outlined.ArrowBack"
                   Class="user-editor-back align-self-start"
                   Href="security/users">
            Users
        </MudButton>

        <MudPaper Outlined="true" Class="user-editor-summary">
            <div class="user-editor-header">
                <div class="user-editor-identity">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Outlined.ManageAccounts" />
                    </MudAvatar>
                    <div class="user-editor-title-group">
                        <MudText Typo="Typo.h5" HtmlTag="h1" Class="user-editor-title">@EditorTitle</MudText>
                        @if (IsNew)
                        {
                            <MudText Typo="Typo.caption">Configure the account identity, roles, and credentials.</MudText>
                        }
                        else
                        {
                            <div class="user-editor-meta">
                                <MudText Typo="Typo.caption" Class="user-editor-id">User ID <code>@Id</code></MudText>
                                <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy"
                                               Size="Size.Small"
                                               OnClick="CopyUserIdAsync"
                                               aria-label="@($"Copy user ID {Id}")" />
                                <MudText Typo="Typo.caption">Scope: @ScopeLabel</MudText>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </MudPaper>

        @if (IsReadOnly)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">You can view this user, but your current sign-in cannot edit it.</MudAlert>
        }

        @if (_saveError != null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">@_saveError</MudAlert>
        }

        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudPaper Outlined="true" Elevation="0" Class="pa-4">
                    <div class="user-section-header">
                        <MudText Typo="Typo.h6" HtmlTag="h2" Class="user-section-title">Account</MudText>
                        <MudText Typo="Typo.caption" Class="user-section-hint">
                            @(IsNew ? "Create an Elsa account. The username is the stable identity used to sign in and cannot be changed later." : "The username cannot be changed after the account is created.")
                        </MudText>
                    </div>

                    <MudTextField @bind-Value="_name"
                                  Label="Username"
                                  Required="true"
                                  RequiredError="Enter a username."
                                  ReadOnly="@(!IsNew)"
                                  Disabled="@(IsReadOnly || _saving)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  aria-label="Username" />
                </MudPaper>

                <MudPaper Outlined="true" Elevation="0" Class="pa-4">
                    <div class="user-section-header">
                        <MudText Typo="Typo.h6" HtmlTag="h2" Class="user-section-title">Roles</MudText>
                        <MudText Typo="Typo.caption" Class="user-section-hint">Roles group the permissions this user receives. Core only accepts roles whose permissions your own sign-in already holds.</MudText>
                    </div>

                    @if (_canViewRoles)
                    {
                        <MudSelect T="string"
                                   Label="Assigned roles"
                                   MultiSelection="true"
                                   SelectedValues="_selectedRoles"
                                   SelectedValuesChanged="OnSelectedRolesChanged"
                                   Disabled="@(IsReadOnly || _saving)"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   aria-label="Assigned roles">
                            @foreach (var role in _roleOptions)
                            {
                                <MudSelectItem T="string" Value="@role.Id">@role.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                            Role assignment is unavailable because your sign-in cannot view roles. Ask an administrator for <code>identity/roles:view</code>. Existing assignments are kept as they are.
                        </MudAlert>
                        @if (_selectedRoles.Count > 0)
                        {
                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" aria-label="Current roles" Class="mt-3">
                                @foreach (var role in _selectedRoles.OrderBy(x => x, StringComparer.OrdinalIgnoreCase))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@role</MudChip>
                                }
                            </MudStack>
                        }
                    }
                </MudPaper>

                <MudPaper Outlined="true" Elevation="0" Class="pa-4">
                    <div class="user-section-header">
                        <MudText Typo="Typo.h6" HtmlTag="h2" Class="user-section-title">@PasswordHeading</MudText>
                        <MudText Typo="Typo.caption" Class="user-section-hint">@CredentialGuidance</MudText>
                    </div>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_password"
                                          Label="@PasswordLabel"
                                          InputType="InputType.Password"
                                          Disabled="@(IsReadOnly || _saving)"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_passwordConfirmation"
                                          Label="Confirm password"
                                          InputType="InputType.Password"
                                          Validation="@((string? value) => ValidatePasswordConfirmation(value))"
                                          Disabled="@(IsReadOnly || _saving)"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudStack>
        </MudForm>

        @if (_deleteError != null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert">@_deleteError</MudAlert>
        }

        <div class="user-editor-actions" role="group" aria-label="User form actions">
            @if (CanDelete)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           Class="user-editor-delete-action"
                           Disabled="@(_deleting || _saving)"
                           OnClick="DeleteAsync">
                    Delete user
                </MudButton>
            }
            <div class="user-editor-commit-actions">
                <MudButton Variant="Variant.Text" Href="security/users" Disabled="@(_saving || _deleting)">Cancel</MudButton>
                @if (!IsReadOnly)
                {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               Class="user-editor-primary-action"
                               OnClick="SaveAsync"
                               Disabled="@(!CanSave)">
                        @(_saving ? "Saving…" : SaveLabel)
                    </MudButton>
                }
            </div>
        </div>
    </MudStack>
}
