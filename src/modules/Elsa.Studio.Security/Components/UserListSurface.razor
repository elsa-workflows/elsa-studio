@inherits StudioComponentBase
@implements IAsyncDisposable

<style>
    .users-surface {
        --users-border: var(--mud-palette-lines-default);
        --users-muted: var(--mud-palette-text-secondary);
        --users-primary-aa: color-mix(in srgb, var(--mud-palette-primary), var(--mud-palette-text-primary) 32%);
    }

    .users-surface .users-primary-action.mud-button-filled { background-color: var(--users-primary-aa); }
    .users-list-surface { background-color: var(--mud-palette-surface); border-radius: 4px; margin-top: 16px; overflow: hidden; }
    .users-toolbar { align-items: center; display: flex; flex-wrap: wrap; gap: 16px; justify-content: flex-end; min-height: 64px; padding: 0 8px 0 16px; }
    .users-search { max-width: 400px; width: 100%; }
    .users-count, .users-visually-hidden { clip: rect(0 0 0 0); clip-path: inset(50%); height: 1px; overflow: hidden; position: absolute; white-space: nowrap; width: 1px; }
    .users-desktop-list { background-color: transparent; }
    .users-table .mud-table-cell { vertical-align: middle; }
    .user-name { font-weight: 600; }
    .user-row-link, .user-card-link { color: inherit; text-decoration: none; }
    .user-row-link:hover .user-name, .user-row-link:focus-visible .user-name, .user-card-link:hover .user-name, .user-card-link:focus-visible .user-name { color: var(--users-primary-aa); text-decoration: underline; }
    .users-actions { text-align: right; white-space: nowrap; width: 1%; }
    .users-mobile-list { display: none; gap: 12px; margin-top: 16px; }
    .user-card { padding: 16px; }
    .user-card-header { align-items: flex-start; display: flex; gap: 12px; justify-content: space-between; }
    .user-card-content { min-width: 0; }
    .user-card-link { display: block; min-width: 0; }
    .user-card-meta { color: var(--users-muted); margin-top: 8px; }
    .user-card-roles { align-items: center; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .users-state-card { align-items: center; border: 1px solid var(--users-border); display: flex; flex-direction: column; gap: 12px; justify-content: center; margin-top: 16px; min-height: 220px; padding: 32px 24px; text-align: center; }
    .users-no-pagination { align-items: center; border-top: 1px solid var(--users-border); color: var(--users-muted); display: flex; gap: 8px; justify-content: flex-end; min-height: 52px; padding: 12px 16px; }

    @@media (max-width: 959.98px) {
        .users-list-surface { background-color: transparent; overflow: visible; }
        .users-toolbar { min-height: 0; padding: 0; }
        .users-desktop-list { display: none; }
        .users-mobile-list { display: grid; }
        .users-search { max-width: none; }
    }

    @@media (min-width: 960px) {
        .users-desktop-list { display: block; }
    }
</style>

<div class="users-surface">
    <PageHeading Text="Users" />

    @if (!Access.CanCreate && !Access.CanUpdate && !Access.CanDelete)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
            You can view users, but you cannot create, edit, or delete them.
        </MudAlert>
    }

    @if (_actionError != null)
    {
        <MudAlert Severity="@(_actionError.IsConflict ? Severity.Warning : Severity.Error)"
                  Variant="Variant.Outlined"
                  ShowCloseIcon="true"
                  CloseIconClicked="@(() => _actionError = null)"
                  Class="mt-4">
            @_actionError.Message
        </MudAlert>
    }

    <MudPaper Elevation="0" Class="users-list-surface">
        <div class="users-toolbar" role="search">
            <MudTextField T="string"
                          Value="@_search"
                          ValueChanged="OnSearchChanged"
                          Placeholder="Search by name, ID, role, or tenant"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Outlined.Search"
                          Clearable="true"
                          Immediate="true"
                          Class="users-search"
                          aria-label="Search users by name, ID, role, or tenant" />

            @if (Access.CanCreate)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Class="users-primary-action"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           Href="security/users/new"
                           aria-label="Create a new user">
                    New user
                </MudButton>
            }
        </div>

        @if (!_loading && _loadError is null)
        {
            <div class="users-count" role="status" aria-live="polite">@ResultSummary</div>
        }

        @if (_loading)
        {
            <MudPaper Outlined="true" Class="users-state-card" Role="status">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="Loading users" />
                <MudText Typo="Typo.body2">Loading users...</MudText>
            </MudPaper>
        }
        else if (_loadError != null)
        {
            <MudPaper Outlined="true" Class="users-state-card" Role="alert">
                <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Color="Color.Error" Size="Size.Large" aria-hidden="true" />
                <MudText Typo="Typo.h6">Users could not be loaded</MudText>
                <MudText Typo="Typo.body2">@_loadError.Message</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="users-primary-action" OnClick="ReloadAsync" aria-label="Try loading users again">Try again</MudButton>
            </MudPaper>
        }
        else if (_users.Count == 0)
        {
            <MudPaper Outlined="true" Class="users-state-card">
                <MudIcon Icon="@Icons.Material.Outlined.People" Color="Color.Secondary" Size="Size.Large" aria-hidden="true" />
                <MudText Typo="Typo.h6">No users yet</MudText>
                <MudText Typo="Typo.body2">@(Access.CanCreate ? "Create a user to grant access to Elsa." : "No accounts exist in this tenant scope.")</MudText>
                @if (Access.CanCreate)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="users-primary-action" Href="security/users/new" aria-label="Create your first user">Create first user</MudButton>
                }
            </MudPaper>
        }
        else if (FilteredUsers.Count == 0)
        {
            <MudPaper Outlined="true" Class="users-state-card">
                <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Color="Color.Secondary" Size="Size.Large" aria-hidden="true" />
                <MudText Typo="Typo.h6">No matching users</MudText>
                <MudText Typo="Typo.body2">Try a different name, ID, role, or tenant.</MudText>
            </MudPaper>
        }
        else
        {
            <div class="users-desktop-list">
                <MudTable T="UserSummary" Items="@FilteredUsers" Dense="true" Hover="true" Elevation="0" RowStyle="cursor: pointer;" OnRowClick="OpenUser" Class="users-table">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>ID</MudTh>
                        <MudTh>Roles</MudTh>
                        <MudTh>Scope</MudTh>
                        @if (Access.CanUpdate || Access.CanDelete)
                        {
                            <MudTh Class="users-actions"><span class="users-visually-hidden">Actions</span></MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">
                            <a class="user-row-link" href="@UserUrl(context.Id)" aria-label="@($"Open user {context.Name}")" @onclick:stopPropagation="true">
                                <MudText Typo="Typo.body2" Class="user-name">@context.Name</MudText>
                            </a>
                        </MudTd>
                        <MudTd DataLabel="ID">
                            <IdentityIdCell Value="@context.Id" Label="User" OnCopy="@(() => CopyUserIdAsync(context.Id))" />
                        </MudTd>
                        <MudTd DataLabel="Roles"><UserRolePreview Roles="@context.Roles" /></MudTd>
                        <MudTd DataLabel="Scope">@Scope(context.TenantId)</MudTd>
                        @if (Access.CanUpdate || Access.CanDelete)
                        {
                            <MudTd DataLabel="Actions" Class="users-actions" @onclick:stopPropagation="true">
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" Disabled="@IsDeleting(context.Id)" AriaLabel="@($"Actions for {context.Name}")">
                                    @if (Access.CanUpdate)
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Outlined.Edit" Href="@UserUrl(context.Id)">Edit</MudMenuItem>
                                    }
                                    @if (Access.CanDelete)
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Outlined.Delete" Disabled="@IsDeleting(context.Id)" OnClick="@(() => DeleteAsync(context))">Delete</MudMenuItem>
                                    }
                                </MudMenu>
                            </MudTd>
                        }
                    </RowTemplate>
                </MudTable>
                <div class="users-no-pagination" role="note">
                    <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" aria-hidden="true" />
                    <span>All matching users are shown. No pagination.</span>
                </div>
            </div>

            <div class="users-mobile-list" aria-label="Users list">
                @foreach (var user in FilteredUsers)
                {
                    <MudPaper Outlined="true" Class="user-card">
                        <div class="user-card-header">
                            <a class="user-card-link user-card-content" href="@UserUrl(user.Id)" aria-label="@($"Open user {user.Name}")">
                                <MudText Typo="Typo.body1" Class="user-name">@user.Name</MudText>
                            </a>
                            @if (Access.CanUpdate || Access.CanDelete)
                            {
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" Disabled="@IsDeleting(user.Id)" AriaLabel="@($"Actions for {user.Name}")">
                                    @if (Access.CanUpdate)
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Outlined.Edit" Href="@UserUrl(user.Id)">Edit</MudMenuItem>
                                    }
                                    @if (Access.CanDelete)
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Outlined.Delete" Disabled="@IsDeleting(user.Id)" OnClick="@(() => DeleteAsync(user))">Delete</MudMenuItem>
                                    }
                                </MudMenu>
                            }
                        </div>
                        <div class="user-card-meta">
                            <IdentityIdCell Value="@user.Id" Label="User" OnCopy="@(() => CopyUserIdAsync(user.Id))" />
                            <MudText Typo="Typo.caption">Scope: @Scope(user.TenantId)</MudText>
                        </div>
                        <div class="user-card-roles">
                            <MudText Typo="Typo.caption">Roles</MudText>
                            <UserRolePreview Roles="@user.Roles" />
                        </div>
                    </MudPaper>
                }
            </div>
        }
    </MudPaper>
</div>
