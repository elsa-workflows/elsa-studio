<MudPaper Outlined="true" Class="pa-3">
    <MudStack Spacing="1">
        <MudText Typo="Typo.subtitle2">@Field.DisplayName</MudText>
        <MudText Typo="Typo.caption">@(Binding?.IsConfigured == true ? Binding.IsResolvable ? "Configured and resolvable" : "Configured but not currently resolvable" : "Not configured")</MudText>
        @if (!ReadOnly)
        {
            <MudTextField @bind-Value="_resolverType" Label="Resolver type" Placeholder="elsa-secrets" Required="true" />
            <MudTextField @bind-Value="_reference" Label="Secret reference" HelperText="A non-secret lookup reference; the secret value is never revealed." Required="true" />
            <MudStack Row="true">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ReplaceAsync">Replace binding</MudButton>
                @if (Binding?.IsConfigured == true)
                {
                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="RemoveAsync">Remove binding</MudButton>
                }
            </MudStack>
        }
    </MudStack>
</MudPaper>

@code {
    private string _resolverType = string.Empty;
    private string _reference = string.Empty;

    [Parameter, EditorRequired] public ConnectionFieldDescriptor Field { get; set; } = default!;
    [Parameter] public SecretBindingState? Binding { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback<SecretBindingMutation> OnReplace { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }

    protected override void OnParametersSet()
    {
        _resolverType = Binding?.ResolverType ?? "elsa-secrets";
        _reference = Binding?.Reference ?? string.Empty;
    }

    private Task ReplaceAsync() => OnReplace.InvokeAsync(new SecretBindingMutation { ResolverType = _resolverType, Reference = _reference, ExpectedType = Binding?.ExpectedType, ExpectedScope = Binding?.ExpectedScope });
    private Task RemoveAsync() => OnRemove.InvokeAsync();
}
