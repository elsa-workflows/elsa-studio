<MudPaper Outlined="true" Class="pa-3">
    <MudStack Spacing="2">
        <MudText Typo="Typo.subtitle2">@Field.DisplayName</MudText>
        <MudText Typo="Typo.caption">@(Binding?.IsConfigured == true ? Binding.IsResolvable ? "Configured and resolvable" : "Configured but not currently resolvable" : "Not configured")</MudText>
        @if (!ReadOnly)
        {
            @if (!CanManage)
            {
                <MudAlert Severity="Severity.Info" Dense="true">Save the connection draft before configuring secrets.</MudAlert>
            }
            else
            {
                @if (ManagedSecretResolvers.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2">Managed secret</MudText>
                    <MudSelect T="string" @bind-Value="_managedResolverType" Label="Secret store" Required="true">
                        @foreach (var resolver in ManagedSecretResolvers)
                        {
                            <MudSelectItem T="string" Value="@resolver.Type">@resolver.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="_managedValue"
                                  Label="Secret value"
                                  InputType="InputType.Password"
                                  autocomplete="new-password"
                                  HelperText="Write-only. Elsa stores the value and never returns it to Studio." />
                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               Disabled="@(string.IsNullOrWhiteSpace(_managedResolverType) || string.IsNullOrWhiteSpace(_managedValue))"
                               OnClick="ReplaceManagedAsync">
                        Replace managed secret
                    </MudButton>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        @(ManagedSecretResolverError ?? "Managed secret storage is not available on this Elsa server.")
                    </MudAlert>
                }

                <MudExpansionPanels Elevation="0">
                    <MudExpansionPanel Text="Advanced: External binding" Expanded="@IsExternalBinding">
                        <MudTextField @bind-Value="_resolverType" Label="Resolver type" Required="true" />
                        <MudTextField @bind-Value="_reference" Label="Secret reference" HelperText="A non-secret lookup reference; no secret value passes through Studio." Required="true" />
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ReplaceExternalAsync">Replace external binding</MudButton>
                    </MudExpansionPanel>
                </MudExpansionPanels>

                @if (Binding?.IsConfigured == true)
                {
                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" Disabled="@(!CanRemove)" OnClick="RemoveAsync">
                        @(IsManagedBinding ? "Remove managed secret" : "Remove external binding")
                    </MudButton>
                }
                @if (Binding?.IsConfigured == true && !CanRemove)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        This required secret cannot be removed while the connection is enabled. Disable the connection first.
                    </MudAlert>
                }
            }
        }
    </MudStack>
</MudPaper>

@code {
    private string _resolverType = string.Empty;
    private string _reference = string.Empty;
    private string _managedResolverType = string.Empty;
    private string _managedValue = string.Empty;

    [Parameter, EditorRequired] public ConnectionFieldDescriptor Field { get; set; } = default!;
    [Parameter] public SecretBindingState? Binding { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool CanManage { get; set; } = true;
    [Parameter] public bool CanRemove { get; set; } = true;
    [Parameter] public ICollection<ManagedSecretResolverDescriptor> ManagedSecretResolvers { get; set; } = [];
    [Parameter] public string? ManagedSecretResolverError { get; set; }
    [Parameter] public EventCallback<SecretBindingMutation> OnReplace { get; set; }
    [Parameter] public EventCallback<ManagedSecretMutation> OnManagedReplace { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }

    private bool IsManagedBinding => string.Equals(Binding?.Ownership, "managed", StringComparison.OrdinalIgnoreCase);
    private bool IsExternalBinding => string.Equals(Binding?.Ownership, "external", StringComparison.OrdinalIgnoreCase) && Binding?.IsConfigured == true;

    protected override void OnParametersSet()
    {
        _resolverType = Binding?.ResolverType ?? string.Empty;
        _reference = Binding?.Reference ?? string.Empty;
        if (string.IsNullOrWhiteSpace(_managedResolverType) || ManagedSecretResolvers.All(x => !string.Equals(x.Type, _managedResolverType, StringComparison.Ordinal)))
            _managedResolverType = ManagedSecretResolvers.FirstOrDefault(x => string.Equals(x.Type, "elsa-secrets", StringComparison.Ordinal))?.Type
                ?? ManagedSecretResolvers.FirstOrDefault()?.Type
                ?? string.Empty;
    }

    private Task ReplaceExternalAsync() => OnReplace.InvokeAsync(new SecretBindingMutation
    {
        Ownership = "external",
        ResolverType = _resolverType,
        Reference = _reference,
        ExpectedType = Binding?.ExpectedType,
        ExpectedScope = Binding?.ExpectedScope
    });

    private async Task ReplaceManagedAsync()
    {
        if (string.IsNullOrWhiteSpace(_managedResolverType) || string.IsNullOrWhiteSpace(_managedValue))
            return;
        var value = _managedValue;
        _managedValue = string.Empty;
        await OnManagedReplace.InvokeAsync(new ManagedSecretMutation { ResolverType = _managedResolverType, Value = value });
    }

    private Task RemoveAsync() => OnRemove.InvokeAsync();
}
