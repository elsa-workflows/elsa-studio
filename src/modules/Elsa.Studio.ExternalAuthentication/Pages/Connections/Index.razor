@page "/security/external-authentication/connections"
@using Elsa.Studio.ExternalAuthentication.Services
@inject Elsa.Studio.Contracts.IBackendApiClientProvider ApiClientProvider
@inject Elsa.Studio.ExternalAuthentication.Services.IExternalAuthenticationPermissionService Permissions
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Identity provider connections</PageTitle>

<MudContainer MaxWidth="MaxWidth.False">
    <PageHeading Text="Identity provider connections" />
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
        @ConfigurationGuidance
    </MudAlert>

    <MudPaper Elevation="0" Class="pa-4">
        <MudGrid Spacing="2" Class="mb-4 align-center">
            <MudItem xs="12" sm="6" md="4">
                <MudTextField T="string" Value="_search" ValueChanged="SetSearchAsync" Label="Search connections" Immediate="true" DebounceInterval="300" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.Search" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="string" Value="_source" ValueChanged="SetSourceAsync" Label="Source" Clearable="true">
                    <MudSelectItem T="string" Value="@("database")">Database</MudSelectItem>
                    <MudSelectItem T="string" Value="@("configuration")">Configuration</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCheckBox T="bool" Value="_includeArchived" ValueChanged="SetIncludeArchivedAsync" Label="Include archived" />
            </MudItem>
            @if (_canCreate)
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudStack Row="true" Justify="Justify.FlexEnd">
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">Create connection</MudButton>
                    </MudStack>
                </MudItem>
            }
        </MudGrid>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" aria-label="Loading identity provider connections" />
        }
        else if (!_canRead)
        {
            <MudAlert Severity="Severity.Warning">You do not have permission to view identity provider connections.</MudAlert>
        }
        else
        {
            <MudTable T="ConnectionSummary" Items="_items" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Md">
                <HeaderContent>
                    <MudTh>Connection</MudTh>
                    <MudTh>Source</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Latest test</MudTh>
                    <MudTh aria-label="Actions"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Connection">
                        <MudText Typo="Typo.body2">@context.DisplayName</MudText>
                        <MudText Typo="Typo.caption">@context.Key · @context.AdapterType</MudText>
                        @if (context.IsPreferred)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">Preferred</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Source">
                        <MudChip T="string" Size="Size.Small" Color="@(context.IsConfigurationOwned ? Color.Info : Color.Default)">@context.Source</MudChip>
                        @if (context.Shadowed)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                                @(context.IsConfigurationOwned ? "Shadowed by Studio" : "Shadowed by deployment")
                            </MudChip>
                        }
                        @if (context.OverridesConfigurationConnection)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary">Studio override</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@ConnectionStatusPresentation.LifecycleColor(context)">@ConnectionStatusPresentation.LifecycleDisplayLabel(context)</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="@ConnectionStatusPresentation.ValidityColor(context.Validity)">@ConnectionStatusPresentation.ValidityDisplayLabel(context)</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Latest test">
                        @if (context.LatestObservation is { } observation)
                        {
                            <MudText Typo="Typo.caption">@observation.Status@(observation.IsStale ? " (stale)" : string.Empty)</MudText>
                            <MudText Typo="Typo.caption">@observation.Summary</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption">Not tested</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align: right;">
                        <MudMenu
                            Icon="@Icons.Material.Filled.MoreVert"
                            Size="Size.Small"
                            Dense="true"
                            AriaLabel="@($"Actions for {context.DisplayName}")">
                            <MudMenuItem
                                Icon="@(context.IsConfigurationOwned ? Icons.Material.Outlined.Pageview : Icons.Material.Outlined.Edit)"
                                OnClick="@(() => OpenAsync(context))">
                                @(context.IsConfigurationOwned ? "View" : "Manage")
                            </MudMenuItem>
                            @if (ConnectionActionAvailability.CanEnableOrDisable(context, _canUpdate))
                            {
                                <MudMenuItem
                                    Icon="@(context.EnabledIntent ? Icons.Material.Outlined.ToggleOff : Icons.Material.Outlined.ToggleOn)"
                                    OnClick="@(() => ToggleEnabledAsync(context))">
                                    @(context.EnabledIntent ? "Disable" : "Enable")
                                </MudMenuItem>
                            }
                        </MudMenu>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText>No connections match the current filters.</MudText></NoRecordsContent>
            </MudTable>
            <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3" aria-label="Connection pages">
                <MudText Typo="Typo.caption">Page @_paging.PageNumber</MudText>
                <MudButton Variant="Variant.Outlined" Disabled="@(!_paging.HasPrevious || _loading)" OnClick="PreviousPageAsync">Previous page</MudButton>
                <MudButton Variant="Variant.Outlined" Disabled="@(!_paging.HasNext || _loading)" OnClick="NextPageAsync">Next page</MudButton>
            </MudStack>
        }
    </MudPaper>
</MudContainer>

@code {
    private readonly List<ConnectionSummary> _items = [];
    private string? _search;
    private string? _source;
    private readonly Elsa.Studio.ExternalAuthentication.Services.ConnectionListPagingState _paging = new();
    private readonly Elsa.Studio.ExternalAuthentication.Services.ConnectionListRequestState _requests = new();
    private bool _includeArchived;
    private bool _loading = true;
    private bool _canRead;
    private bool _canCreate;
    private bool _canUpdate;
    private bool _canRevokeSessions;
    private bool _configurationOverridesAllowed;

    private string ConfigurationGuidance => _configurationOverridesAllowed
        ? "Configuration-owned connections are shown for diagnosis and remain read-only. Authorized administrators can create or promote a Studio record to override deployment configuration. Enabled, valid Studio database connections become login methods without a restart."
        : "Configuration-owned connections are shown for diagnosis and can only be changed through deployment configuration. Enabled, valid database connections become login methods without a restart.";

    protected override async Task OnInitializedAsync()
    {
        _canRead = await Permissions.HasAsync(ExternalAuthenticationPermissions.Read);
        _canCreate = await Permissions.HasAsync(ExternalAuthenticationPermissions.Create);
        _canUpdate = await Permissions.HasAsync(ExternalAuthenticationPermissions.Update);
        _canRevokeSessions = await Permissions.HasAsync(ExternalAuthenticationPermissions.SessionsRevoke);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _paging.Replace(null);
        await LoadAsync();
    }

    private async Task SetSearchAsync(string? search)
    {
        _search = search;
        await ReloadAsync();
    }

    private async Task SetSourceAsync(string? source)
    {
        _source = source;
        await ReloadAsync();
    }

    private async Task SetIncludeArchivedAsync(bool includeArchived)
    {
        _includeArchived = includeArchived;
        await ReloadAsync();
    }

    private async Task NextPageAsync()
    {
        if (_paging.TryAdvance(out var cursor))
            await LoadAsync(cursor);
    }

    private async Task PreviousPageAsync()
    {
        if (_paging.TryGoBack(out var cursor))
            await LoadAsync(cursor);
    }

    private async Task LoadAsync(string? cursor = null)
    {
        var request = _requests.Begin();
        if (!_canRead)
        {
            if (_requests.IsCurrent(request))
                _loading = false;
            return;
        }

        var search = _search;
        var source = _source;
        var includeArchived = _includeArchived;
        _loading = true;
        try
        {
            var api = await ApiClientProvider.GetApiAsync<IExternalAuthenticationConnectionsApi>();
            var response = await api.ListAsync(search, source, archived: includeArchived ? null : false, cursor: cursor, pageSize: 25);
            if (!_requests.IsCurrent(request))
                return;

            _items.Clear();
            _items.AddRange(response.Items);
            _configurationOverridesAllowed |= response.Items.Any(connection =>
                connection.IsConfigurationOwned && (connection.CanCreateOverride || connection.CanPromoteToConfigurationOverride));
            _paging.SetNext(response.NextCursor);
        }
        catch (Exception exception)
        {
            if (_requests.IsCurrent(request))
                Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            if (_requests.IsCurrent(request))
                _loading = false;
        }
    }

    private void CreateAsync() => Navigation.NavigateTo("security/external-authentication/connections/new");
    private void OpenAsync(ConnectionSummary connection) => Navigation.NavigateTo($"security/external-authentication/connections/{Uri.EscapeDataString(connection.Id)}");
    private async Task ToggleEnabledAsync(ConnectionSummary connection)
    {
        if (!ConnectionActionAvailability.CanEnableOrDisable(connection, _canUpdate))
            return;

        var completedAction = connection.EnabledIntent ? "disabled" : "enabled";
        try
        {
            if (connection.EnabledIntent)
            {
                var decision = await ConnectionDisableConfirmation.ShowAsync(Dialogs, connection.DisplayName, _canRevokeSessions);
                if (decision is null)
                    return;

                var operations = await ApiClientProvider.GetApiAsync<IExternalAuthenticationOperationsApi>();
                await operations.DisableWithRecoveryOverrideAsync(
                    connection.Id,
                    ConnectionConcurrency.ToIfMatch(connection.Revision),
                    false,
                    decision == ConnectionDisableDecision.RevokeActiveSessions);
            }
            else
            {
                if (await Dialogs.ShowMessageBoxAsync(
                        "Enable connection?",
                        $"Enable {connection.DisplayName}.",
                        yesText: "Enable",
                        cancelText: "Cancel") != true)
                    return;

                var api = await ApiClientProvider.GetApiAsync<IExternalAuthenticationConnectionsApi>();
                await api.EnableAsync(connection.Id, ConnectionConcurrency.ToIfMatch(connection.Revision));
            }

            Snackbar.Add($"Connection {completedAction}.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }
}
