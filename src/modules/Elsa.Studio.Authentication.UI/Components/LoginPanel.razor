@inject IEnumerable<ILoginMethodCatalog> Catalogs
@inject ILoginMethodComponentRegistry Components

<section class="elsa-login-panel" aria-labelledby="elsa-login-heading">
    <MudText HtmlTag="h2" Typo="Typo.h4" id="elsa-login-heading">
        @Localizer["Sign in"]
    </MudText>
    <MudText Typo="Typo.body1" Class="elsa-login-panel__intro">
        @Localizer["Choose a sign-in method for {0}.", ApplicationName]
    </MudText>

    @foreach (var warning in _warnings)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" role="status">@warning</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" aria-label="@Localizer["Loading sign-in methods"]" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert>
    }
    else if (_methods.Count == 0)
    {
        <MudAlert Severity="Severity.Warning" role="status">
            @Localizer["No sign-in methods are currently available. Contact an administrator."]
        </MudAlert>
    }
    else
    {
        <div class="elsa-login-panel__methods" aria-label="@Localizer["Sign-in methods"]">
            @foreach (var method in LocalMethods)
            {
                @RenderMethod(method)
            }

            @if (LocalMethods.Count > 0 && ExternalMethods.Count > 0)
            {
                <div class="elsa-login-panel__divider" role="separator">
                    <span>@Localizer["Or continue with"]</span>
                </div>
            }

            @foreach (var method in ExternalMethods)
            {
                @RenderMethod(method)
            }
        </div>
    }
</section>

@code {
    [Parameter]
    public string? ReturnPath { get; set; }

    [Parameter]
    public string ApplicationName { get; set; } = "Elsa Studio";

    private readonly List<LoginMethodDescriptor> _methods = [];
    private readonly List<string> _warnings = [];
    private bool _loading = true;
    private string? _error;

    private IReadOnlyList<LoginMethodDescriptor> LocalMethods =>
        _methods.Where(IsLocalMethod).ToArray();

    private IReadOnlyList<LoginMethodDescriptor> ExternalMethods =>
        _methods.Where(x => !IsLocalMethod(x)).ToArray();

    protected override async Task OnInitializedAsync()
    {
        var catalogFailures = 0;

        foreach (var catalog in Catalogs)
        {
            try
            {
                var result = await catalog.ListAsync();
                var preferredKey = result.PreferredMethodKey;
                _methods.AddRange(result.Methods.Select(method => method with
                {
                    IsPreferred = method.IsPreferred ||
                        (!string.IsNullOrWhiteSpace(preferredKey) &&
                         string.Equals(method.Key, preferredKey, StringComparison.Ordinal))
                }));

                if (!string.IsNullOrWhiteSpace(result.SecurityWarning))
                    _warnings.Add(result.SecurityWarning);
            }
            catch
            {
                catalogFailures++;
            }
        }

        var ordered = _methods
            .OrderBy(x => x.Order)
            .ThenBy(x => x.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(x => x.Key, StringComparer.Ordinal)
            .ToArray();
        _methods.Clear();
        _methods.AddRange(ordered);

        if (catalogFailures > 0)
        {
            if (_methods.Count == 0)
                _error = Localizer["Sign-in methods could not be loaded. Try again or contact an administrator."];
            else
                _warnings.Add(Localizer["Some sign-in methods could not be loaded."]);
        }

        _loading = false;
    }

    private RenderFragment RenderMethod(LoginMethodDescriptor method) => builder =>
    {
        if (!Components.TryResolve(method.Kind, out var provider))
            return;

        builder.OpenElement(0, "section");
        builder.AddAttribute(1, "class", "elsa-login-panel__method");
        builder.AddAttribute(2, "aria-label", method.DisplayName);

        if (method.IsPreferred)
        {
            builder.OpenComponent<MudChip<string>>(3);
            builder.AddComponentParameter(4, nameof(MudChip<string>.Size), Size.Small);
            builder.AddComponentParameter(5, nameof(MudChip<string>.Color), Color.Primary);
            builder.AddComponentParameter(6, nameof(MudChip<string>.Class), "elsa-login-panel__preferred");
            builder.AddComponentParameter(7, nameof(MudChip<string>.ChildContent),
                (RenderFragment)(chipBuilder => chipBuilder.AddContent(0, Localizer["Preferred"])));
            builder.CloseComponent();
        }

        builder.OpenComponent<DynamicComponent>(8);
        builder.AddComponentParameter(9, nameof(DynamicComponent.Type), provider.ComponentType);
        builder.AddComponentParameter(10, nameof(DynamicComponent.Parameters), ParametersFor(method));
        builder.CloseComponent();
        builder.CloseElement();
    };

    private IDictionary<string, object> ParametersFor(LoginMethodDescriptor method) =>
        new Dictionary<string, object>
        {
            ["Context"] = new LoginMethodComponentContext(method, NormalizeReturnPath(ReturnPath), ReportFailureAsync)
        };

    private Task ReportFailureAsync(string message)
    {
        _error = message;
        return InvokeAsync(StateHasChanged);
    }

    private static bool IsLocalMethod(LoginMethodDescriptor method) =>
        string.Equals(method.Kind, "local", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(method.Kind, "elsa-identity", StringComparison.OrdinalIgnoreCase);

    private static string NormalizeReturnPath(string? candidate)
    {
        if (string.IsNullOrWhiteSpace(candidate) ||
            !candidate.StartsWith("/", StringComparison.Ordinal) ||
            candidate.StartsWith("//", StringComparison.Ordinal) ||
            candidate.Contains('\\'))
            return "/";

        return Uri.TryCreate(candidate, UriKind.Relative, out _) ? candidate : "/";
    }
}
